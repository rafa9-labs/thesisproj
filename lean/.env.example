# KodaQuant LEAN Bridge — Environment Variables
# Copy this to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.

# --- Interactive Brokers ---
IB_USER_NAME=
IB_ACCOUNT=
IB_PASSWORD=

# --- IB Gateway (Docker) ---
# ghcr.io/gnzsnz/ib-gateway defaults:
IB_GATEWAY_PORT=4001
IB_GATEWAY_HOST=ib-gateway

# --- Trading Mode ---
# "paper" = simulated trading via IB paper account
# "live"  = real money trading
TRADING_MODE=paper

# --- LEAN Engine ---
# REST API port exposed to host (KodaQuant connects to this)
LEAN_REST_PORT=8888

# --- IB Gateway Docker Image ---
IB_GATEWAY_IMAGE=ghcr.io/gnzsnz/ib-gateway:latest

# --- IB Controller (auto-restart on forced logoff) ---
IB_CONTROLLER_IMAGE=ghcr.io/gnzsnz/ib-gateway:latest
