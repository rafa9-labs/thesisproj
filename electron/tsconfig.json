{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "outDir": "../frontend/electron-dist",
    "rootDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": "..",
    "paths": {
      "electron": ["frontend/node_modules/electron"],
      "@sentry/electron/main": ["frontend/node_modules/@sentry/electron/main/index.d.ts"],
      "electron-updater": ["frontend/node_modules/electron-updater/out/main.d.ts"]
    }
  },
  "include": ["./*.ts"]
}
