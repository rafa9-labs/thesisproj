{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "outDir": "../frontend/electron-dist",
    "rootDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "ignoreDeprecations": "6.0",
    "typeRoots": [
      "../frontend/node_modules/@types",
      "../frontend/node_modules/electron"
    ],
    "paths": {
      "electron": ["../frontend/node_modules/electron"]
    }
  },
  "include": ["./*.ts"]
}
