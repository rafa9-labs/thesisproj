# Copy to .env (do NOT commit .env)

# Optional provider creds (only needed if downloading data)
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Vast.ai GPU rental API key (console.vast.ai -> Account -> API keys).
# Used to list rented instances and run remote backtests.
# You may keep keys in .env.local instead (loaded as fallback).
VAST_API_KEY=

# Paddle licensing (fill after Paddle account setup)
PADDLE_VENDOR_ID=
PADDLE_PRODUCT_ID=
PADDLE_API_KEY=
PADDLE_SANDBOX=false

# App security
APP_SECRET=

# Optional run controls
LOG_MODE=COMPACT
CV_DEBUG=0
CV_TABLE_MODE=off
SKIP_PLOTS=0
TF_FORCE_CPU=0
CV_JOBS=
MLB_THREADS=
RESULTS_RUN_DIR=
